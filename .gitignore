# Lock and meta — keep package-locks per package; not at root
# (each package has its own)

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local fixtures and scratch (deliberate: prevent accidental commit of
# real CSAM-adjacent material from local experimentation)
fixtures/local/
fixtures/scratch/
.local/

# WASM artifacts (we publish from CI, not commit)
*.wasm
pkg/

# Cargo lock — workspace of libraries; lockfile not committed
Cargo.lock
/target

# Outreach status — maintainer-private; not for commit
docs/outreach/STATUS.md
