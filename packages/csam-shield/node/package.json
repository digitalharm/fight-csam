{
  "name": "@digitalharm/csam-shield",
  "version": "0.1.0",
  "description": "One-line CSAM detection middleware for Express/Fastify/Hono. Wires PhotoDNA, NCMEC, PDQ, and Cloudflare CSAM Scanning behind a unified interface.",
  "license": "Apache-2.0",
  "homepage": "https://digitalharm.org/tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalharm/digitalharm-oss",
    "directory": "packages/csam-shield/node"
  },
  "bugs": "https://github.com/digitalharm/digitalharm-oss/issues",
  "author": "The Digital Harm Report contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/adapters/fastify.js"
    },
    "./hono": {
      "types": "./dist/adapters/hono.d.ts",
      "import": "./dist/adapters/hono.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "csam",
    "trust-and-safety",
    "middleware",
    "photodna",
    "pdq",
    "ncmec",
    "cloudflare"
  ],
  "publishConfig": {
    "access": "public"
  }
}
